{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/guide", "destination": "/guide/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
